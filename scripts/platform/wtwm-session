#!/bin/sh
# Login-session wrapper: preserve the compositor's exit status, keep a private
# log, and never replace or restart the display manager.
set -u

wtwm_bin=${WTWM_BIN:-wtwm}
case $wtwm_bin in
	*/*) test -x "$wtwm_bin" ;;
	*) command -v "$wtwm_bin" >/dev/null 2>&1 ;;
esac || {
	printf 'wtwm-session: compositor is not executable: %s\n' "$wtwm_bin" >&2
	exit 127
}

test -n "${XDG_RUNTIME_DIR:-}" && test -d "$XDG_RUNTIME_DIR" &&
	test -w "$XDG_RUNTIME_DIR" || {
	printf '%s\n' 'wtwm-session: XDG_RUNTIME_DIR must be a writable directory' >&2
	exit 1
}

# Desktop services are activated by the persistent per-user D-Bus/systemd
# manager, not as direct compositor children.  Mark this as a managed login and
# give wtwm the stable session identity it will publish once its display sockets
# exist.
WTWM_MANAGED_SESSION=1
XDG_CURRENT_DESKTOP=wtwm
XDG_SESSION_DESKTOP=wtwm
XDG_SESSION_TYPE=wayland
export WTWM_MANAGED_SESSION XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
	XDG_SESSION_TYPE

state_home=${XDG_STATE_HOME:-${HOME:?HOME is not set}/.local/state}
log_dir=$state_home/wtwm
umask 077
if mkdir -p -- "$log_dir" 2>/dev/null; then
	chmod 700 "$log_dir" 2>/dev/null || :
	log_file=$log_dir/session.log
else
	printf 'wtwm-session: cannot create %s; logging to stderr\n' "$log_dir" >&2
	log_file=/dev/stderr
fi

child_pid=
forward_signal()
{
	test -z "$child_pid" || kill -TERM "$child_pid" 2>/dev/null || :
}
trap forward_signal HUP INT QUIT TERM

wait_for_child()
{
	last_wait_status=127
	while :; do
		wait "$child_pid"
		waited_status=$?
		test "$waited_status" -eq 127 || last_wait_status=$waited_status
		# A trapped controlling signal may interrupt wait before the child has
		# handled the forwarded TERM.  Keep ownership until it is reaped.  If
		# the child exits between wait and kill, one final wait retrieves the
		# shell's cached child status instead of returning the interruption.
		kill -0 "$child_pid" 2>/dev/null && continue
		wait "$child_pid"
		final_wait_status=$?
		test "$final_wait_status" -eq 127 || return "$final_wait_status"
		return "$last_wait_status"
	done
}

{
	printf 'wtwm-session: starting pid=%s at=%s\n' "$$" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	"$wtwm_bin" "$@" &
	child_pid=$!
	wait_for_child
	status=$?
	child_pid=
	printf 'wtwm-session: compositor exit=%s at=%s\n' "$status" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	exit "$status"
} >>"$log_file" 2>&1
