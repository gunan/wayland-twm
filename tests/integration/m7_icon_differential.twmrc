NoDefaults
NoGrabServer
NoHighlight
NoTitleHighlight
NoTitleFocus
NoMenuShadows
NoRaiseOnMove
NoRaiseOnResize
UsePPosition "on"
ShowIconManager
ForceIcons
BorderWidth 1
IconBorderWidth 2
TitleButtonBorderWidth 0
ButtonIndent 0
FramePadding 2
TitlePadding 2
TitleFont "fixed"
MenuFont "fixed"
IconFont "fixed"
IconManagerFont "fixed"
ResizeFont "fixed"

IconManagerGeometry "320x5+0+0" 2
IconRegion "300x160+300+260" North West 100 80
Icons { "Reference Bravo" "tests/fixtures/xbm/classic_char.xbm" }
StartIconified { "Reference Bravo" }

"F6" = : root : f.warptoiconmgr "Reference Bravo"
"F2" = : iconmgr : f.backiconmgr

Color
{
    BorderColor "#101010"
    BorderTileForeground "#101010"
    BorderTileBackground "#101010"
    TitleForeground "#f0f0f0"
    TitleBackground "#204060"
    DefaultForeground "#e0e0e0"
    DefaultBackground "#252525"
    IconForeground "#eeddaa"
    IconBackground "#733117"
    IconBorderColor "#00aaff"
    IconManagerForeground "#22ff44"
    IconManagerBackground "#113355"
    IconManagerHighlight "#ff00ff"
}
