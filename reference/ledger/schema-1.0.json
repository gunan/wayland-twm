{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference/ledger/schema-1.0.json",
  "title": "wtwm twm compatibility ledger",
  "description": "Schema for deterministic per-syntax compatibility assessments against the frozen twm inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_path",
    "inventory_path",
    "reference",
    "assessment_policy",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "schema_path": {
      "const": "reference/ledger/schema-1.0.json"
    },
    "inventory_path": {
      "const": "reference/inventory/twm-1.0.13.1.json"
    },
    "reference": {
      "$ref": "#/$defs/reference"
    },
    "assessment_policy": {
      "$ref": "#/$defs/assessment_policy"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ledger_entry"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "archive",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "archive": {
          "$ref": "#/$defs/repository_path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "assessment_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "initial_status",
        "scope",
        "next_step"
      ],
      "properties": {
        "phase": {
          "enum": [
            "inventory-initialized",
            "current-implementation-audited"
          ]
        },
        "initial_status": {
          "const": "unassessed"
        },
        "scope": {
          "const": "One row for every keyword, grammar alternative, and successful lexer form in the frozen upstream inventory."
        },
        "next_step": {
          "const": "Milestone 0 implementation item 4 audits the current wtwm implementation and replaces unassessed values with evidence-backed assessments."
        }
      }
    },
    "ledger_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "inventory_section",
        "upstream",
        "syntax_support",
        "runtime_support",
        "native_wayland_behavior",
        "xwayland_behavior",
        "test_coverage",
        "differences"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(keyword|grammar|lexical)\\.[a-z0-9_.-]+$"
        },
        "inventory_section": {
          "enum": [
            "keywords",
            "grammar",
            "lexical_forms"
          ]
        },
        "upstream": {
          "oneOf": [
            {
              "$ref": "#/$defs/upstream_keyword"
            },
            {
              "$ref": "#/$defs/upstream_grammar"
            },
            {
              "$ref": "#/$defs/upstream_lexical_form"
            }
          ]
        },
        "syntax_support": {
          "$ref": "#/$defs/syntax_assessment"
        },
        "runtime_support": {
          "$ref": "#/$defs/behavior_assessment"
        },
        "native_wayland_behavior": {
          "$ref": "#/$defs/behavior_assessment"
        },
        "xwayland_behavior": {
          "$ref": "#/$defs/behavior_assessment"
        },
        "test_coverage": {
          "$ref": "#/$defs/test_coverage"
        },
        "differences": {
          "$ref": "#/$defs/differences"
        }
      }
    },
    "upstream_keyword": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "spelling",
        "parser_token",
        "parser_value",
        "categories",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "spelling": {
          "type": "string"
        },
        "parser_token": {
          "type": "string"
        },
        "parser_value": {
          "type": "string"
        },
        "categories": {
          "$ref": "#/$defs/categories"
        },
        "evidence": {
          "$ref": "#/$defs/upstream_evidence"
        }
      }
    },
    "upstream_grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "production",
        "ordinal",
        "syntax",
        "categories",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "production": {
          "type": "string"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "syntax": {
          "type": "string"
        },
        "categories": {
          "$ref": "#/$defs/categories"
        },
        "evidence": {
          "$ref": "#/$defs/upstream_evidence"
        }
      }
    },
    "upstream_lexical_form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pattern",
        "categories",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "categories": {
          "$ref": "#/$defs/categories"
        },
        "evidence": {
          "$ref": "#/$defs/upstream_evidence"
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "directive",
          "color-monochrome-option",
          "window-list-directive",
          "mouse-binding-form",
          "key-binding-form",
          "binding-context",
          "binding-modifier",
          "built-in-action",
          "menu-construct",
          "icon-option",
          "icon-manager-option",
          "cursor-option",
          "pixmap-option",
          "font-option",
          "placement-option",
          "title-button-option",
          "direction-or-justification",
          "lexical-form",
          "grammar-structure"
        ]
      }
    },
    "upstream_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_member",
        "line",
        "text"
      ],
      "properties": {
        "archive_member": {
          "type": "string",
          "pattern": "^twm-1\\.0\\.13\\.1/(src|man)/[A-Za-z0-9._/-]+$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "syntax_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "unassessed",
            "unsupported",
            "partial",
            "complete"
          ]
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "behavior_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "unassessed",
            "unsupported",
            "parsed-only",
            "partial",
            "behaviorally-equivalent",
            "exact",
            "verified-no-op",
            "not-applicable"
          ]
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "test_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "mappings",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "unassessed",
            "none",
            "partial",
            "complete"
          ]
        },
        "mappings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/test_mapping"
          }
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "test_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "path",
        "case",
        "dimensions",
        "assertions"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "pattern": "^test\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "pattern": "^tests/[A-Za-z0-9._/-]+$"
        },
        "case": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "syntax",
              "runtime",
              "native-wayland",
              "xwayland",
              "visual",
              "semantic"
            ]
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "differences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "visual",
        "semantic",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "unassessed",
            "none-known",
            "known"
          ]
        },
        "visual": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/difference"
          }
        },
        "semantic": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/difference"
          }
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "evidence",
        "tests"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repository_location"
          }
        },
        "tests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^test\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repository_location": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+:[1-9][0-9]*$"
    },
    "repository_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+$"
    }
  }
}
