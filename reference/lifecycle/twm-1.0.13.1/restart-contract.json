  "reference_behavior": {
    "action_identity": {
      "normalized_action": "F_RESTART",
      "aliases": [
        {
          "name": "f.restart",
          "inventory_id": "keyword.f.restart",
          "parser_token": "FKEYWORD",
          "parser_value": "F_RESTART",
          "evidence": "parse.f-restart"
        },
        {
          "name": "f.twmrc",
          "inventory_id": "keyword.f.twmrc",
          "parser_token": "FKEYWORD",
          "parser_value": "F_RESTART",
          "evidence": "parse.f-twmrc"
        }
      ],
      "rule": "The two spellings have one parser action identity and reach the same F_RESTART dispatch with no alias-specific branch."
    },
    "process_restart": {
      "execution_model": "replace-process-image",
      "program": "*Argv",
      "arguments": "Argv",
      "argv_origin": "main-argv",
      "argv_assignment_count": 1,
      "sequence": [
        "synchronize-x-server",
        "reborder-managed-windows",
        "synchronize-x-server",
        "close-session-manager-connection-if-present",
        "exec-original-argv"
      ],
      "rule": "At startup twm retains main's argc and argv directly; F_RESTART restores X-side window borders and replaces twm with execvp using the retained original argv vector.",
      "evidence": [
        "startup.argc",
        "startup.argv",
        "restart.dispatch",
        "restart.reborder",
        "restart.exec-original-argv"
      ]
    }
  },
  "wayland_translation": {
    "action_identity": {
      "normalized_action": "F_RESTART",
      "aliases": [
        "f.restart",
        "f.twmrc"
      ],
      "dispatch": "one-shared-handler",
      "alias_specific_behavior": false
    },
    "restart_transaction": {
      "execution_model": "in-process",
      "atomicity": "prepare-validate-commit-or-no-change",
      "candidate_config_isolated": true,
      "commit_only_after_full_validation": true,
      "exec_or_exit": false,
      "phases": [
        "parse replacement configuration into isolated candidate state",
        "validate the complete candidate without mutating the active generation",
        "atomically publish the candidate and refresh compositor-owned observable state",
        "on any failure discard the candidate and retain the active generation and session"
      ]
    },
    "client_continuity": {
      "required_protocols": [
        "native-wayland",
        "xwayland"
      ],
      "connection_identity_preserved": true,
      "restart_xwayland": false,
      "disconnect_clients": false,
      "preserve_managed_state": [
        "client-and-surface-identity",
        "mapping-and-iconification",
        "geometry",
        "stacking",
        "focus"
      ]
    },
    "invalid_replacement": {
      "result": "reject-and-retain-active-session",
      "active_config_preserved": true,
      "active_generation_preserved": true,
      "observable_state_unchanged": true,
      "clients_preserved": true,
      "diagnostic_required": true
    },
    "observable_refresh": {
      "trigger": "successful-transaction-commit-only",
      "publish_as_one_generation": true,
      "refresh_before_next_input_dispatch": [
        "bindings-and-action-resolution",
        "menus-and-named-functions",
        "configuration-derived-policy",
        "decorations-colors-fonts-and-cursors",
        "compositor-owned-icons-and-icon-managers"
      ],
      "preserve_unless_new_config_explicitly_changes_presentation": [
        "managed-client-identity",
        "mapping-and-iconification",
        "geometry",
        "stacking",
        "focus"
      ],
      "failed_transaction_refresh": "none"
    }
  },
  "requirements": [
    {
      "id": "restart.action-identity",
      "level": "MUST",
      "rule": "f.restart and f.twmrc normalize to F_RESTART and invoke the same handler.",
      "evidence": [
        "parse.f-restart",
        "parse.f-twmrc",
        "restart.dispatch"
      ]
    },
    {
      "id": "restart.in-process-atomic",
      "level": "MUST",
      "rule": "wtwm performs restart as an in-process candidate-config transaction and never execs or exits for this action.",
      "evidence": [
        "restart.exec-original-argv"
      ]
    },
    {
      "id": "restart.native-continuity",
      "level": "MUST",
      "rule": "All existing native Wayland protocol connections and managed surfaces survive the transaction.",
      "evidence": [
        "restart.exec-original-argv"
      ]
    },
    {
      "id": "restart.xwayland-continuity",
      "level": "MUST",
      "rule": "The Xwayland server and all existing Xwayland client connections survive the transaction.",
      "evidence": [
        "restart.reborder",
        "restart.exec-original-argv"
      ]
    },
    {
      "id": "restart.invalid-retention",
      "level": "MUST",
      "rule": "An invalid replacement configuration leaves the active configuration generation, clients, and observable session state unchanged and reports a diagnostic.",
      "evidence": [
        "restart.exec-original-argv"
      ]
    },
    {
      "id": "restart.observable-refresh",
      "level": "MUST",
      "rule": "A valid replacement is published as one generation and all contracted compositor-owned observable state is refreshed before the next input dispatch.",
      "evidence": [
        "restart.dispatch"
      ]
    }
  ],
  "verification_scenarios": [
    {
      "id": "alias-equivalence",
      "actions": [
        "f.restart",
        "f.twmrc"
      ],
      "oracle": "Identical traces enter one F_RESTART handler and commit the same candidate generation."
    },
    {
      "id": "valid-restart-with-active-clients",
      "protocols": [
        "native-wayland",
        "xwayland"
      ],
      "oracle": "Both client connection identities and managed state survive while every observable-refresh category changes to the valid replacement generation."
    },
    {
      "id": "invalid-restart-with-active-clients",
      "protocols": [
        "native-wayland",
        "xwayland"
      ],
      "oracle": "The action reports a diagnostic; active config generation, observable state, client connections, and managed state are unchanged."
    },
    {
      "id": "repeated-valid-invalid-restart",
      "protocols": [
        "native-wayland",
        "xwayland"
      ],
      "oracle": "Alternating valid and invalid candidates commits only valid generations without leaking handlers, duplicating UI, restarting Xwayland, or disconnecting clients."
    }
  ]
}
