  "wayland_translation": {
    "save_transaction": {
      "trigger": "f.saveyourself",
      "scope": "all-current-compositor-owned-restorable-state",
      "format": "wtwm-compositor-state",
      "schema_version": 1,
      "atomicity": "write-complete-temporary-file-fsync-and-atomic-rename",
      "publish_only_after_complete_validation": true,
      "partial_snapshot_allowed": false,
      "failure_result": "retain-prior-snapshot-and-running-session-with-diagnostic"
    },
    "xwayland_client_protocol": {
      "target": "selected-xwayland-client",
      "advertised_result": "send WM_SAVE_YOURSELF ClientMessage and atomically save compositor-owned state",
      "unadvertised_result": "ring the compatibility bell and still atomically save compositor-owned state",
      "message_requires_advertisement": true,
      "claim_client_saved_process_state": false
    },
    "native_client_protocol": {
      "equivalent_client-save-protocol": "none",
      "result": "atomically save compositor-owned state only",
      "claim_client_saved_process_state": false
    },
    "identity_matching": {
      "match_cardinality": "exactly-one-live-client-to-exactly-one-saved-record",
      "native_wayland_keys": [
        "protocol-native-wayland",
        "app-id",
        "title"
      ],
      "xwayland_keys": [
        "protocol-xwayland",
        "same-xwayland-generation-xid-or-wm-class-instance-and-class",
        "wm-window-role",
        "sm-client-id-when-present",
        "title"
      ],
      "missing_identity_result": "skip-record-with-diagnostic",
      "ambiguous_identity_result": "skip-all-conflicting-records-with-diagnostic",
      "positional_or-arrival-order_fallback": false
    },
    "restorable_state": {
      "fields": [
        "geometry",
        "iconic-state",
        "relative-stack",
        "focus",
        "manual-icon-position",
        "auto-raise",
        "zoom-restore-data"
      ],
      "geometry_rule": "restore position and size, then clamp the complete visible frame to current output bounds",
      "iconic_rule": "restore only mapped normal or iconic compositor presentation, never client process state",
      "relative_stack_rule": "reconstruct order only among uniquely matched clients while preserving current layer constraints",
      "focus_rule": "restore only to a uniquely matched client that is mapped, non-iconic, and currently focusable",
      "manual_icon_position_rule": "restore compositor-owned manual icon coordinates and clamp them to current output bounds",
      "auto_raise_rule": "restore the compositor-owned per-client auto-raise policy bit",
      "zoom_restore_rule": "restore the compositor-owned pre-zoom geometry and active zoom mode only when valid on current outputs"
    },
    "excluded_state": {
      "never_claimed": [
        "client-process-lifetime",
        "client-owned-document-or-application-state",
        "client-private-protocol-state",
        "unadvertised-WM_SAVE_YOURSELF-completion",
        "relaunching-clients"
      ],
      "rule": "Persistence records compositor observations and policy only; it neither serializes client-owned state nor promises that a client process can be recreated."
    },
    "restore_transaction": {
      "enabled_by": "RestartPreviousState",
      "accepted_format": "wtwm-compositor-state",
      "accepted_schema_versions": [
        1
      ],
      "phases": [
        "read the complete candidate snapshot without mutating the session",
        "validate format version structure values and record uniqueness",
        "match records only to unique native Wayland or Xwayland identities",
        "derive clamped geometry stack focus icon and zoom state for current outputs",
        "publish the valid matched restoration as one compositor generation"
      ],
      "malformed_result": "reject-whole-snapshot-retain-running-session-and-report-diagnostic",
      "unsupported_version_result": "reject-whole-snapshot-retain-running-session-and-report-diagnostic",
      "ambiguous_records_result": "skip-conflicting-records-and-restore-other-valid-unique-records",
      "no_partial_publish_on_validation_failure": true
    }
  },
  "requirements": [
    {
      "id": "state.upstream-saveyourself-protocol",
      "level": "MUST",
      "rule": "For a selected Xwayland client advertising WM_SAVE_YOURSELF, f.saveyourself sends that exact ClientMessage; it never claims success for client-owned or process state.",
      "evidence": [
        "protocol.detect-saveyourself",
        "saveyourself.require-advertisement",
        "saveyourself.client-message"
      ]
    },
    {
      "id": "state.atomic-versioned-snapshot",
      "level": "MUST",
      "rule": "f.saveyourself publishes a complete schema-versioned compositor-owned snapshot atomically or retains the prior snapshot and active session.",
      "evidence": [
        "saveyourself.dispatch"
      ]
    },
    {
      "id": "state.unique-protocol-identities",
      "level": "MUST",
      "rule": "Restoration uses protocol-specific native Wayland and Xwayland identities only when saved and live records match uniquely; ambiguity is diagnosed and skipped.",
      "evidence": [
        "wm-state.read"
      ]
    },
    {
      "id": "state.safe-field-set",
      "level": "MUST",
      "rule": "Restoration is limited to geometry, iconic state, relative stack, eligible focus, manual icon position, auto-raise, and valid zoom restore data owned by the compositor.",
      "evidence": [
        "restartpreviousstate.accept-states",
        "restartpreviousstate.normal-property",
        "restartpreviousstate.iconic"
      ]
    },
    {
      "id": "state.output-safe-restoration",
      "level": "MUST",
      "rule": "Restored geometry, icon positions, and zoom data are validated and clamped against the current output topology before publication.",
      "evidence": [
        "restartpreviousstate.normal-map"
      ]
    },
    {
      "id": "state.focus-eligibility",
      "level": "MUST",
      "rule": "Saved focus is restored only when its unique target is mapped, non-iconic, and focusable in the current session.",
      "evidence": [
        "restartpreviousstate.accept-states"
      ]
    },
    {
      "id": "state.invalid-snapshot-retention",
      "level": "MUST",
      "rule": "Malformed or unsupported snapshot data is rejected before mutation with a diagnostic and without harming the running session.",
      "evidence": [
        "restartpreviousstate.fallback"
      ]
    },
    {
      "id": "state.no-client-owned-claims",
      "level": "MUST",
      "rule": "The persistence contract never claims to save client processes, documents, private protocol state, or any other client-owned state.",
      "evidence": [
        "saveyourself.client-message"
      ]
    }
  ],
  "verification_scenarios": [
    {
      "id": "advertised-xwayland-save",
      "kind": "valid",
      "oracle": "The selected client receives one WM_SAVE_YOURSELF ClientMessage and the complete compositor-owned snapshot atomically replaces the prior version."
    },
    {
      "id": "mixed-protocol-valid-restore",
      "kind": "valid",
      "oracle": "Unique native Wayland and Xwayland clients regain all safe fields in relative order; geometry, icons, and zoom data are valid on current outputs."
    },
    {
      "id": "changed-output-topology",
      "kind": "valid",
      "oracle": "Off-output frames and manual icons are clamped visibly, invalid zoom geometry is normalized, and no client is disconnected."
    },
    {
      "id": "iconic-client-saved-focus",
      "kind": "valid",
      "oracle": "Iconic presentation is restored but focus is not restored to that client."
    },
    {
      "id": "ambiguous-native-or-xwayland-identity",
      "kind": "invalid-record",
      "oracle": "Every conflicting saved record is skipped with a diagnostic while other uniquely matched valid records may restore atomically."
    },
    {
      "id": "malformed-snapshot",
      "kind": "invalid-snapshot",
      "oracle": "The complete candidate is rejected before mutation; clients and active compositor state remain unchanged."
    },
    {
      "id": "unsupported-schema-version",
      "kind": "unsupported-snapshot",
      "oracle": "The complete candidate is rejected with a diagnostic; the running session is preserved unchanged."
    },
    {
      "id": "unadvertised-xwayland-and-native-save",
      "kind": "unsupported-client-protocol",
      "oracle": "No WM_SAVE_YOURSELF message is fabricated and no client-owned state is claimed; compositor-owned state is still saved atomically."
    }
  ]
}
